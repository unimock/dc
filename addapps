#!/bin/bash
VERSION="0.0.1"

list="
addapps;additional-apps;--version;https://mde.gate-7.de/addapps/addapps
selfextractor;selfextractor;--version;https://mde.gate-7.de/addapps/selfextractor
sshenc;ssh-encryption;--version;https://mde.gate-7.de/addapps/sshenc
stc;syncthing-cli;;https://github.com/tenox7/stc/releases/download/1.4/stc-amd64-linux
difft;difftastic;--version;https://github.com/Wilfred/difftastic/releases/download/0.48.0/difft-x86_64-unknown-linux-gnu.tar.gz
drone;drone-cli;--version;https://github.com/harness/drone-cli/releases/latest/download/drone_linux_amd64.tar.gz
"

_install() {
  name="$1"
  url="$2"

  FI=$(mktemp)
  wget -q -O $FI $url
  if [ -f /usr/local/bin/$name ] ; then
    sudo cp -f /usr/local/bin/$name /usr/local/bin/$name.backup
  fi
  sudo rm -f /usr/local/bin/$name
  if [[ $url == *".tar.gz" ]] ; then
    sudo tar -C /usr/local/bin/ -xzvf $FI
  else
    sudo cp $FI /usr/local/bin/$name
  fi
  sudo chmod 755 /usr/local/bin/$name
  sudo chown root:root /usr/local/bin/$name
  rm $FI
}

show_help()
{
  if [ "$1" = "" ] ; then
    echo ""
    echo "usage: $(basename $0) [-v|--version|-h|--help] update|list|install <app_name>"
    echo ""
    exit 0
  fi
}

if [[ "$1" == "" ]] ; then
  show_help
  exit 0
fi

options=$(getopt -l "help,version" -o "hvp:" -a -- "$@")
eval set -- "$options"
while true ; do
  case "$1" in
  -h|--help) 
    show_help
    exit 0
    ;;
  -v|--version) 
    echo "$VERSION"
    exit 0
    ;;
  -p)
    shift
    xxxxx="$1"
    ;;
  --)
    shift
    break;;
  esac
  shift
done

echo "$list" | while read -r i ; do

  name=$( echo "$i" | cut -d";" -f1)
  bez=$(  echo "$i" | cut -d";" -f2)
  ver_cmd=$(  echo "$i" | cut -d";" -f3)
  url=$(  echo "$i" | cut -d";" -f4)
  if [ "$name" = "" ] ; then continue ; fi
  state="-"
  if [ -e /usr/local/bin/$name ] ; then
    state="I"
  fi
  if [ "$ver_cmd" != "" ] ; then
    version=$( /usr/local/bin/$name $ver_cmd 2>/dev/null | grep -o '[0-9,.]*' )
  else
    version="-"
  fi
  if [[ "$1" == "list" ]] ; then
    printf "%-1s %-15s %-10s %-20s # %s\n" $state $name $version $bez $url
  fi
  if [[ "$1" == "update" && "$name" == "addapps"  ]] ; then
    _install "$name" "$url"
    exit
  fi
  if [[ "$1" == "install" && "$2" == "$name" ]] ; then
    _install "$name" "$url"
    exit 0
  fi

done

