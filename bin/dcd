#!/bin/bash

if [ ! -f ./dcd.list ] ; then
  exit 0
fi

if [ "$1" = "pull" ] ; then
  HNAME=$(hostname)
  if ! dc data mount ; then
    echo "error: 'dc data mount' failed; aborting pull to avoid data loss" >&2
    exit 1
  fi
  rm -rvf ./dcd.${HNAME}
  list=$(cat dcd.list)
  for i in $list ; do
    ( cd data || exit 1 ; rsync -Rav "$i" "../dcd.${HNAME}" )
  done
  dc data umount
fi

