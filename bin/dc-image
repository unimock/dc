#!/bin/bash

. /opt/dc/funcs/global

IAM=`basename $0`

show_help() {
  echo "# usage: $IAM list|update"
  echo ""
  echo "# examples:"
  echo ""
  echo "$IAM ls              # list used images and their states"
  echo "$IAM ls --skip       # list without inspecting (no remote update-check, show current versions only)"
  echo "$IAM ls --json       # machine-readable JSON output (for the web-UI)"
  echo ""
  echo "$IAM update <app>  koenkk/zigbee2mqtt:2.1.1"
  echo ""
} 

if [ "$1" = "" ] ; then
  show_help
  exit 0
fi

# inspection is the default; --skip turns off the remote update-check.
# --inspect is kept as a hidden no-op for symmetry with dc-ls.
opt_inspect="1"
opt_json="0"
options=$(getopt -l "help,skip,inspect,json" -o "hp:" -a -- "$@")
eval set -- "$options"
while true ; do
  case "$1" in
  -h|--help)
    show_help
    exit 0
    ;;
  --skip)
    opt_inspect="0"
    ;;
  --inspect)
    opt_inspect="1"
    ;;
  --json)
    opt_json="1"
    ;;
  -p)
    shift
    xxxxx="$1"
    ;;
  --)
    shift
    break;;
  esac
  shift
done

if [ "$1" = "ls" ] ; then
  return_code=0
  #
  # inspection: fetch the remote image list and build the update comparison
  # list. skipped with --skip, where only the local current versions are shown.
  #
  update_list=""
  if [ "$opt_inspect" = "1" ] ; then
    url=$(   dc-yq '.config.cluster.image_list.url'   )
    if [ "$url" = "null" -o "$url" = "" ] ; then
      echo "error: image_list.url undefined in cluster.yml" >&2
      exit 1
    fi
    groups=$(dc-yq '.config.cluster.image_list.groups.[]')
    FI=$(mktemp)
    if ! wget -q -O "$FI" "$url" || [ ! -s "$FI" ] ; then
      echo "error: could not fetch image list from <$url>" >&2
      rm -f "$FI"
      exit 1
    fi
    for g in $groups ; do
      update_list="$update_list "$(dc-yq '.'$g'.[]' $FI)
    done
    #update_list=$(dc-yq '.'$g'.[]' $FI)
    rm $FI
  fi
  #
  # create information arrays
  #
  idx=0
  #
  # single consolidated yq pass instead of ~3 per-app dc-yq spawns (each
  # re-parsing the whole merged yaml). emit one "app|node|image" line per
  # (app, node, image); disabled apps filtered, apps without a home-node get
  # an empty node column, images sorted+deduped. app order kept alphabetical
  # (sort_by), node order as declared in dc.home, mirroring the old nesting.
  # images are read from the merged .apps.<app>.compose (same content the
  # rendered compose_yml held after `dc-config`).
  #
  while IFS='|' read -r app hnode image ; do
    [ -z "$app" ] && continue
    apps[$idx]="$app"
    nodes[$idx]="$hnode"
    img_name[$idx]=${image%:*}
    img_ver[$idx]=${image#*:}
    state[$idx]=" "
    for u in $update_list ; do
      u_name=${u%:*}
      u_ver[$idx]=${u#*:}
      if [ "${u_name}" = "${img_name[$idx]}" ] ; then
        if [ "${u_ver[$idx]}" = "${img_ver[$idx]}" ] ; then
          state[$idx]="o"
        else
          state[$idx]="!"
        fi
        break
      fi
    done
    let idx=$idx+1
  done < <( dc-yq -r '
      .apps | to_entries | sort_by(.key) | .[]
      | select(.value.dc.image_list.disabled != true)
      | . as $e
      | ([$e.value.compose.services[].image] | unique) as $imgs
      | ($e.value.dc.home // [{}]) as $homes
      | $homes[] as $h
      | $imgs[] as $img
      | ($e.key + "|" + ($h.node // "") + "|" + $img)
    ' ${MDE_DC_YAML} )
  #
  # print informations
  #
  MASK="|%-1s|%-16s|%-16s|%-30s|%-20s|%-20s|\n"
  if [ "$opt_json" != "1" ] ; then
    printf "$MASK" "  " "app             " "node            " "image                         " "current version     " "new version         "
    printf "$MASK" "--" "----------------" "----------------" "------------------------------" "--------------------" "--------------------"
  fi
  found="0"
  json_rows=()
  for (( idx=0; idx < ${#state[@]}; idx++ )) ; do
    dstate="⬜" ; jstatus="unmanaged" ; jreason="not_in_image_list"
    new_version="                    "
    new_version_json="null"
    if [ "$opt_inspect" != "1" ] ; then
      # no inspection -> show current versions only, mark as unchecked
      dstate="☐ " ; jstatus="unchecked" ; jreason="not_inspected"
    elif [ "${state[$idx]}" = "o" ] ; then
      dstate="✅" ; jstatus="ok" ; jreason="current"
    elif  [ "${state[$idx]}" = "!" ] ; then
      dstate="☑ " ; jstatus="outdated" ; jreason="newer_available"
      new_version=${u_ver[$idx]}
      new_version_json=$( jq -cn --arg v "${u_ver[$idx]}" '$v' )
      return_code=254
    fi
    if [ "${state[$idx]}" = "!" ] ; then
      found="1"
    fi
    if [ "$opt_json" = "1" ] ; then
      json_rows+=( "$( jq -cn \
        --arg app "${apps[$idx]}" --arg status "$jstatus" --arg status_reason "$jreason" \
        --arg node "${nodes[$idx]}" --arg image "${img_name[$idx]}" \
        --arg current_version "${img_ver[$idx]}" --argjson new_version "$new_version_json" \
        '{app:$app, status:$status, status_reason:$status_reason, node:$node, image:$image, current_version:$current_version, new_version:$new_version}' )" )
    else
      printf "$MASK" "${dstate}" "${apps[$idx]}" "${nodes[$idx]}" "${img_name[$idx]:0:30}" "${img_ver[$idx]}" "${new_version}"
    fi
  done
  if [ "$opt_json" = "1" ] ; then
    items="[]"
    [ ${#json_rows[@]} -gt 0 ] && items=$( printf '%s\n' "${json_rows[@]}" | jq -s . )
    insp_bool=false ; [ "$opt_inspect" = "1" ] && insp_bool=true
    jq -n --arg kind "images" --argjson inspected "$insp_bool" \
          --arg generated_at "$(date +%Y-%m-%dT%H:%M:%S%:z)" --argjson items "$items" \
          '{kind:$kind, inspected:$inspected, generated_at:$generated_at, count:($items|length), items:$items}'
    exit $return_code
  fi
  if [ "${found}" = "1" ] ; then
    #
    # print update commands
    #
    printf "\n\n"
    # das update-kommando ist pro app (bearbeitet die compose_yml), nicht pro
    # node. durch die node-expansion kommt dieselbe (app,image,version)-kombi
    # mehrfach vor -> hier deduplizieren.
    declare -A _seen_upd
    for (( idx=0; idx < ${#state[@]}; idx++ )) ; do
      if [ "${state[$idx]}" = "!" ] ; then
        key="${apps[$idx]}|${img_name[$idx]}|${u_ver[$idx]}"
        if [ -z "${_seen_upd[$key]}" ] ; then
          _seen_upd[$key]=1
          printf "%s update %-16s %s:%s\n" "$IAM" "${apps[$idx]}" "${img_name[$idx]}" "${u_ver[$idx]}"
        fi
      fi
    done
    printf "\n\n"
  fi
  exit $return_code
fi

if [ "${1}" = "update" ] ; then
  app="$2"
  image="$3"

  yaml_file=$(dc-yq '.apps.'$app'.compose_yml')
  app_dir=$(dc-yq '.apps.'$app'.app_dir')
  if [ "$app_dir" = "null" -o -z "$app_dir" -o "$yaml_file" = "null" -o -z "$yaml_file" ] ; then
    echo "error: unknown app <$app>"
    exit 1
  fi

  ( cd "${app_dir}" || exit 1 ; dc docker pull ${image} )
  if [ "$?" != "0" ] ; then
    echo "error: downloading image <${image}>!!!"
    exit 1
  fi
  name=${image%:*}
  version=${image#*:}
  services=$(dc-yq '(.services.* | path )[-1]' $yaml_file )
  for s in $services ; do
    current_image=$( dc-yq '.services.'$s'.image' $yaml_file )
    if [[ $current_image == "${name}:"* ]] ; then
       dc-yq -i '.services.'$s'.image = "'${image}'"' $yaml_file 
    fi
  done
  ( cd "${app_dir}" || exit 1 ; dc rmup )
  rc=$?
  if [ "$rc" != "0" ] ; then
    echo "error: redeploy (dc rmup) failed for app <${app}>!!!"
  fi
  exit $rc
fi

exit 0
