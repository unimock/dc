#!/bin/bash
cmd=""
para=""
for i in "$@" ; do
  if [[ $i == -* ]] ; then
    para="$para $i"
    shift
  else
    cmd=$i ; shift
    break
  fi 
done
if [ -z "$cmd" ] ; then
  cmd=""
fi
if [ $# = 0 ] ; then
  /opt/dc/external/yq $para "$cmd" ${MDE_DC_YAML}
else
  /opt/dc/external/yq $para "$cmd" $@
fi
exit $?

