#!/bin/bash

. /opt/dc/funcs/global

_show_help() {
  echo ""
  echo " usage: dc app <app> <command> ..."
  echo ""
  echo "    state disabled            # stop app and disable it in ${MDE_DC_YAML_FILE}"
  echo "    state active              # enable app in ${MDE_DC_YAML_FILE} and start it"
  echo "    config <cmd> ...          # app configuration (see dc-config)"
  echo ""
  echo "    all other commands are passed to 'dc -a <app> <command>', e.g.:"
  echo "    up|rm|rmup|down           # create/remove app containers"
  echo "    start|stop                # start or stop app containers"
  echo "    pause|unpause             # pause or unpause app containers"
  echo "    ps                        # show app containers"
  echo "    logs [-f]                 # print logs"
  echo "    login [--root] [<cmd>]    # login into main service"
  echo "    data ...                  # mount/pull/push app data"
  echo ""
  echo "  list of apps: dc ls apps"
  echo ""
}


verbose=""
CURROPT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -v) verbose="1"               ; shift 1 ;;
    *)  CURROPT="$CURROPT \"${1//\"/\\\"}\"" ; shift 1 ;;
  esac
done
eval set -- $CURROPT

if [ "$1" = "" ] ; then
  _show_help
  exit 0
fi

#echo $*
app=$1
shift
CMD="$1"
shift
if [ "$CMD" = "state"  ] ; then
  YML=$(dc-yq .apps.${app}.dc_yml)
  if [ "$1" = "disabled"  ] ; then
    dc -a ${app} rm
    dc-yq -i '.app.home.[].state = "disabled"' $YML
    exit 0
  elif [ "$1" = "active"  ] ; then
    dc-yq -i '.app.home.[].state = "active"'   $YML
    dc -a ${app} up
    exit 0
  fi
elif [ "$CMD" = "config"  ] ; then
  cmd=$1
  shift
  dc-config $cmd app ${app} $@
  exit $?
fi

# alle anderen Kommandos (rm, up, rmup, ps, start, stop, logs, data, login, ...) an dc durchreichen
dc -a ${app} $CMD "$@"
exit $?
