#!/bin/bash

. /opt/dc/funcs/global

_show_help() {
  echo ""
  echo " usage: dc app <app> <command> ..."
  echo ""
  echo "    disable                   # dc down, then set home[].state active -> disabled in ${MDE_DC_YAML_FILE}"
  echo "    enable                    # set home[].state disabled -> active in ${MDE_DC_YAML_FILE}, then dc up"
  echo "    state disabled|active     # same as disable|enable"
  echo "    config <cmd> ...          # app configuration (see dc-config)"
  echo "    dir                       # print the app directory (exit 1 if app unknown)"
  echo ""
  echo "    all other commands are passed to 'dc -a <app> <command>', e.g.:"
  echo "    up                        # create and start app containers"
  echo "    rm                        # stop and remove app containers (networks stay)"
  echo "    rmup                      # rm, then up"
  echo "    down                      # stop and remove app containers and networks (state in ${MDE_DC_YAML_FILE} unchanged)"
  echo "    start|stop                # start or stop app containers"
  echo "    pause|unpause             # pause or unpause app containers"
  echo "    ps                        # show app containers"
  echo "    logs [-f] [-n <lines>]    # print logs (docker compose logs options)"
  echo "    login [--root] [<cmd>]    # login into main service"
  echo "    data ...                  # mount/pull/push app data"
  echo ""
  echo "  list of apps: dc ls apps"
  echo ""
}


verbose=""
CURROPT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -v) verbose="1"               ; shift 1 ;;
    *)  CURROPT="$CURROPT \"${1//\"/\\\"}\"" ; shift 1 ;;
  esac
done
eval set -- $CURROPT

if [ "$1" = "" ] ; then
  _show_help
  exit 0
fi

#echo $*
app=$1
shift
CMD="$1"
shift
if [ "$CMD" = "state" -o "$CMD" = "disable" -o "$CMD" = "enable" ] ; then
  # disable: dc down, then home[].state active -> disabled
  # enable:  home[].state disabled -> active, then dc up
  # home entries with other states (e.g. standby) stay unchanged
  case "$CMD:$1" in
    disable:|state:disabled) target="disabled" ; from="active"   ;;
    enable:|state:active)    target="active"   ; from="disabled" ;;
    *)
      echo "error: invalid argument <$CMD $*>" >&2
      _show_help
      exit 1
      ;;
  esac
  YML=$( dc-yq '.apps.'${app}'.dc_yml' ${MDE_DC_YAML} )
  if [ "$YML" = "null" -o "$YML" = "" -o ! -f "$YML" ] ; then
    echo "error: unknown app <${app}>" >&2
    exit 1
  fi
  cnt=$( dc-yq '[.app.home[] | select(.state == "'$from'")] | length' "$YML" )
  if [ "$cnt" = "0" ] ; then
    echo "💡 app <${app}> is already ${target} in ${YML}"
  fi
  if [ "$target" = "disabled" ] ; then
    dc -a ${app} down
    rc=$?
    if [ "$rc" != "0" ] ; then
      echo "!!! error=$rc dc down <${app}>, ${MDE_DC_YAML_FILE} unchanged" >&2
      exit $rc
    fi
    if [ "$cnt" != "0" ] ; then
      dc-yq -i '(.app.home[] | select(.state == "active") | .state) = "disabled"' "$YML" || exit $?
    fi
    exit 0
  else
    if [ "$cnt" != "0" ] ; then
      dc-yq -i '(.app.home[] | select(.state == "disabled") | .state) = "active"' "$YML" || exit $?
    fi
    dc -a ${app} up
    rc=$?
    if [ "$rc" != "0" ] ; then
      echo "!!! error=$rc dc up <${app}> (state is active, see: dc app ${app} logs)" >&2
    fi
    exit $rc
  fi
elif [ "$CMD" = "dir"  ] ; then
  # print the app directory (for scripts/agents: cd "$(dc app <app> dir)")
  app_dir=$( dc-yq '.apps.'${app}'.app_dir' ${MDE_DC_YAML} )
  if [ "$app_dir" = "null" -o "$app_dir" = "" ] ; then
    echo "error: unknown app <${app}>" >&2
    exit 1
  fi
  echo "$app_dir"
  exit 0
elif [ "$CMD" = "config"  ] ; then
  cmd=$1
  shift
  dc-config $cmd app ${app} $@
  exit $?
fi

# alle anderen Kommandos (rm, up, rmup, ps, start, stop, logs, data, login, ...) an dc durchreichen
dc -a ${app} $CMD "$@"
exit $?
