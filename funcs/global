
# arguments for dc-history.log, with secret values masked (--secret=KEY=VALUE -> --secret=KEY=***)
dc_log_args() {
  local a out=""
  for a in "$@" ; do
    [[ "$a" =~ ^(--secret=[^=]*)=(.+)$ && "${BASH_REMATCH[2]}" != "-" ]] && a="${BASH_REMATCH[1]}=***"
    out="$out $a"
  done
  echo "${out# }"
}

# trace calls of dc-xxx scripts (also internal ones, with the calling process). Not for scripts that the
# logging "dc" wrapper started directly ($PPID) or exec'ed ($$): bin/dc has logged that call already.
  if [ "$(basename "$0")" != "dc" -a -n "$MDE_DC_LOG_DIR" ] && [ "$PPID" != "$DC_LOG_PID" -a "$$" != "$DC_LOG_PID" ] ; then
    mkdir -p "$MDE_DC_LOG_DIR" 2>/dev/null
    printf "%-60s # %s %s\n" "$(basename "$0") $(dc_log_args "$@")" "$(date +'%Y-%m-%d %H:%M:%S')" "$(ps -o comm= $PPID)" >> "$MDE_DC_LOG_DIR/dc-history.log"
  fi

if [ "${dc_recursive_call}" != "1" ] ; then
  export dc_recursive_call="1"
  . ${HOME}/.dc/etc/config
  dc-config refresh >/dev/null
fi
